rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if ownProfile(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if ownProfile(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'owner']
        && request.resource.data.approvalStatus
          == (request.resource.data.role == 'owner' ? 'pending' : 'not_required')
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'phoneNumber', 'role',
          'approvalStatus', 'accountStatus', 'createdAt', 'updatedAt'
        ]);

      allow update: if ownProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phoneNumber', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.accountStatus == resource.data.accountStatus
        || isAdmin()
        && resource.data.role == 'owner'
        && resource.data.approvalStatus == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvalStatus', 'rejectionReason', 'updatedAt'])
        && request.resource.data.approvalStatus in ['approved', 'rejected']
        && (request.resource.data.approvalStatus == 'approved'
          || (request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
            && request.resource.data.rejectionReason.size() <= 1000));

      allow delete: if false;
    }

    match /properties/{propertyId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.approvalStatus == 'pending';

      allow get: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.approvalStatus == 'approved');

      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.approvalStatus == 'approved');

      allow update: if isAdmin()
        && resource.data.approvalStatus == 'pending'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvalStatus', 'rejectionReason', 'updatedAt'])
        && request.resource.data.approvalStatus in ['approved', 'rejected']
        && (request.resource.data.approvalStatus == 'approved'
          || (request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
            && request.resource.data.rejectionReason.size() <= 1000));

      allow delete: if false;
    }

    match /rooms/{roomId} {
      function approvedOwner() {
        return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
      }

      function ownedProperty(propertyId) {
        return get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
      }

      function validRoom(data) {
        return data.ownerId is string
          && data.propertyId is string
          && data.roomName is string
          && data.maximumOccupants is int
          && data.maximumOccupants > 0
          && data.currentOccupants is int
          && data.currentOccupants >= 0
          && data.currentOccupants <= data.maximumOccupants
          && data.availableSpaces is int
          && data.availableSpaces == data.maximumOccupants - data.currentOccupants
          && data.availabilityStatus in ['available', 'partially_available', 'occupied', 'temporarily_unavailable']
          && (data.availabilityStatus == 'temporarily_unavailable'
            || (data.currentOccupants == 0 && data.availabilityStatus == 'available')
            || (data.currentOccupants > 0 && data.availableSpaces > 0 && data.availabilityStatus == 'partially_available')
            || (data.availableSpaces == 0 && data.availabilityStatus == 'occupied'));
      }

      allow create: if approvedOwner()
        && request.resource.data.ownerId == request.auth.uid
        && ownedProperty(request.resource.data.propertyId)
        && validRoom(request.resource.data);

      function discoverableRoom() {
        return signedIn()
          && resource.data.availableSpaces > 0;
      }

      allow get, list: if isAdmin()
        || (approvedOwner() && resource.data.ownerId == request.auth.uid)
        || discoverableRoom();

      allow update: if approvedOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.propertyId == resource.data.propertyId
        && ownedProperty(request.resource.data.propertyId)
        && validRoom(request.resource.data);

      allow delete: if (isAdmin() && resource.data.currentOccupants == 0)
        || (approvedOwner() && resource.data.ownerId == request.auth.uid && resource.data.currentOccupants == 0);
    }

    match /bookings/{bookingId} {
      function bookingStudent() {
        return signedIn() && resource.data.studentId == request.auth.uid;
      }

      function bookingOwner() {
        return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
          && resource.data.ownerId == request.auth.uid;
      }

      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.ownerId == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.approvalStatus == 'approved'
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.propertyId == request.resource.data.propertyId
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.isActive == true
        && request.resource.data.numberOfOccupants is int
        && request.resource.data.numberOfOccupants > 0
        && request.resource.data.bookingStatus == 'pending'
        && request.resource.data.rejectionReason == null;

      allow update: if (bookingStudent()
        && resource.data.bookingStatus == 'pending'
        && request.resource.data.bookingStatus == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'updatedAt']))
        || (bookingOwner()
        && resource.data.bookingStatus == 'pending'
        && request.resource.data.bookingStatus in ['accepted', 'rejected', 'expired']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'rejectionReason', 'updatedAt']));

      allow delete: if false;
      allow get, list: if isAdmin() || bookingStudent() || bookingOwner();
    }

    match /notifications/{notificationId} {
      allow create, delete: if false;
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }
  }
}
